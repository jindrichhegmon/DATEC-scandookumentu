# SQL Server Srv-MPerfect – CLB1, tabulka dbo.CLB_SCANN_DOKUMENTU (log dotazů a odpovědí).
# Stejné hodnoty jako /opt/clb-pacienti720/.env
SQL_SERVER=90.182.39.103
SQL_PORT=1433
SQL_DATABASE=CLB1
SQL_USER=clb1_app
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_CERT=true
SQL_TIMEOUT_MS=30000

# Heslo k náhledu uložených záznamů ve stránce (dřív bylo natvrdo ve scénáři Make).
# Bez něj náhled vůbec nejde spustit; zápis logu na něm nezávisí.
SCANLOG_HESLO=

# Samostatný server (server.mjs na VPS): port a adresa za reverse proxy (Caddy)
PORT=3101
HOST=127.0.0.1
TZ=Europe/Prague
